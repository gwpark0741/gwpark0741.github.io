@inproceedings{park2026ksc,
  abbr      = {KSC},
  title     = {오디오 언어모델의 제외형 질문 조건 반영 분석과 반사실적 데이터 학습을 통한 개선},
  author    = {박광웅 and 정도은 and 김민정 and 오윤석 and 조영우 and 장두성},
  booktitle = {한국정보과학회 2026 한국소프트웨어종합학술대회 (채택)},
  year      = {2026},
  month     = nov,
  abstract  = {오디오 언어모델은 "목표 소리 외에 다른 소리가 있는가"를 묻는 제외형 질문에서 텍스트 조건을 응답에 충분히 반영하지 못한다. 이를 반사실적 질문 쌍과 내부 표현 분석(선형 프로빙, 어텐션 차단)으로 보였다. 반사실적 예제로 학습해 쌍 정확도를 5.2~56.2%에서 75.4~84.5%로 높였고, 일반 오디오 이해 성능(MMAU)은 유지했다.},
  selected  = {true},
}

@inproceedings{jeong2026ksc,
  abbr      = {KSC},
  title     = {텍스트 기반 음원 분리 모델에서 입력 문장 교체에 따른 출력 변화 분석},
  author    = {정도은 and 박광웅 and 김민정 and 조영우 and 오윤석 and 장두성},
