  year      = {2026},
  month     = nov,
  abstract  = {텍스트 기반 음원 분리 모델은 한 문장만 쓰면 같은 소리를 다른 표현으로 설명했을 때 얻을 수 있는 더 나은 결과를 놓칠 수 있다. AudioSep, CLAPSep, SAM-Audio에 같은 목표음을 설명하는 세 문장을 입력해 비교한 결과, 세 모델 모두 문장 표현에 따라 출력이 달라졌고 혼합 입력의 약 3분의 2에서 다른 문장으로 얻은 후보가 기준 문장보다 목표음 원본을 더 정확히 복원했다.},
  selected  = {true},
}

